		"userdoc": {
			"kind": "user",
			"methods": {
				"confirmar(uint256)": {
					"notice": "Confirma una propuesta. Solo firmantes; una vez por firmante."
				},
				"ejecutar(uint256)": {
					"notice": "Ejecuta la propuesta si tiene al menos `umbral()` confirmaciones.         Solo firmantes; una única vez. Revierte si la llamada falla."
				},
				"firmantes()": {
					"notice": "Lista de firmantes (útil para las pruebas)."
				},
				"proponer(address,bytes)": {
					"notice": "Propone una llamada a `destino` con `datos` (calldata codificado).         Solo firmantes. La propuesta NO cuenta como confirmación automática."
				},
				"revocarConfirmacion(uint256)": {
					"notice": "Retira la propia confirmación antes de que se ejecute."
				}
			},
