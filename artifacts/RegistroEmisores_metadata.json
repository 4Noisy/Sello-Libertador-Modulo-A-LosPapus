		"devdoc": {
			"details": "Completar los TODO. Requisitos mínimos:         - Solo `administracion` (la dirección de MultifirmaUBO) autoriza y revoca.         - Solo facultades válidas (ConstantesUBO.esFacultadValida).         - Historial de TODOS los periodos: un emisor puede ser autorizado,           revocado y vuelto a autorizar; estabaAutorizado() debe acertar           para cualquier momento pasado.         - Periodos semiabiertos [desde, hasta); hasta = 0 significa abierto.",
			"kind": "dev",
			"methods": {
				"autorizarEmisor(address,bytes32)": {
					"details": "Debe revertir si el emisor ya está autorizado en esa facultad."
				},
				"estabaAutorizado(address,bytes32,uint256)": {
					"details": "Un periodo de autorización es el intervalo [desde, hasta):      incluye `desde` y excluye `hasta`. Un periodo abierto tiene hasta = 0."
				},
				"revocarEmisor(address,bytes32)": {
					"details": "Debe revertir si el emisor no está autorizado en esa facultad."
				}
			},
			"stateVariables": {
				"_periodos": {
					"details": "Historial de periodos por emisor y facultad, en orden cronológico."
				}
